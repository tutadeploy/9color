[mysqld]
# 基础设置
default-storage-engine = InnoDB
sql_mode = ONLY_FULL_GROUP_BY,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# 连接设置 - 大幅增加并发处理能力
max_connections = 500                # 从300增加到500个连接
max_user_connections = 450           # 从270增加到450个用户连接
max_connect_errors = 100
interactive_timeout = 600            # 从28800减少到600秒(10分钟)
wait_timeout = 600                   # 从28800减少到600秒(10分钟)

# 字符集设置
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB 设置 - 优化并发和锁处理
innodb_buffer_pool_size = 1G         # 从768M增加到1G
innodb_log_file_size = 256M
innodb_log_buffer_size = 64M         # 从32M增加到64M
innodb_flush_log_at_trx_commit = 2
innodb_lock_wait_timeout = 300       # 从120秒增加到300秒(5分钟)
innodb_rollback_on_timeout = 1       # 新增：超时时回滚事务
innodb_io_capacity = 400             # 从200增加到400
innodb_read_io_threads = 16          # 从8增加到16个读线程
innodb_write_io_threads = 16         # 从8增加到16个写线程
innodb_thread_concurrency = 32      # 从16增加到32个并发线程

# 事务隔离级别优化 - 减少锁冲突
transaction-isolation = READ-COMMITTED

# 查询缓存（MySQL 5.7）- 增加缓存能力
query_cache_type = 1
query_cache_size = 128M              # 从64M增加到128M
query_cache_limit = 8M               # 从4M增加到8M

# 表缓存 - 增加缓存能力
table_open_cache = 8192              # 从4096增加到8192
table_definition_cache = 4096        # 从2048增加到4096

# 慢查询日志
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# 错误日志
log-error = /var/log/mysql/error.log

# 二进制日志（用于备份和主从复制）
log-bin = mysql-bin
server-id = 1
binlog_format = ROW
binlog_cache_size = 64K              # 从32K增加到64K
max_binlog_cache_size = 1G           # 从512M增加到1G
max_binlog_size = 128M
expire_logs_days = 7
sync_binlog = 1

# 网络设置
bind-address = 0.0.0.0
port = 3306
max_allowed_packet = 128M            # 从64M增加到128M

# 安全设置
local-infile = 0
skip-symbolic-links

# 事件调度器 - 启用自动派单系统
event_scheduler = ON

# 性能优化 - 大幅提升处理能力
tmp_table_size = 128M                # 从32M增加到128M
max_heap_table_size = 128M           # 从32M增加到128M
sort_buffer_size = 4M                # 从2M增加到4M
read_buffer_size = 256K              # 从128K增加到256K
read_rnd_buffer_size = 512K          # 从256K增加到512K
myisam_sort_buffer_size = 16M        # 从8M增加到16M
thread_cache_size = 128              # 从64增加到128

# 新增：并发优化配置
innodb_autoinc_lock_mode = 2         # 优化自增锁模式
innodb_deadlock_detect = 1           # 启用死锁检测
innodb_print_all_deadlocks = 1       # 记录所有死锁信息
concurrent_insert = 2                # 允许并发插入

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
port = 3306 